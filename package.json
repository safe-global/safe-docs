{
  "version": "4.41.0",
  "description": "Safe docs",
  "scripts": {
    "build": "next build && pnpm generate-agent-files",
    "check-build": "pnpm ts-node --project tsconfig.json .github/scripts/checkBuildOutput.ts",
    "dev": "next dev",
    "generate-agent-files": "pnpm ts-node --project tsconfig.json .github/scripts/generateAgentFiles.ts",
    "generate-api-reference": "pnpm ts-node --project tsconfig.json .github/scripts/generateApiReference.ts",
    "generate-code-examples": "pnpm ts-node --project tsconfig.json .github/scripts/generateCodeExamples.ts",
    "generate-supported-networks": "pnpm ts-node --project tsconfig.json .github/scripts/generateSupportedNetworks.ts",
    "get-resources-og": "node .github/scripts/getResourcesOg.js",
    "validate-resources": "node .github/scripts/validateResources.js",
    "linkcheck": "pnpm ts-node --project tsconfig.json .github/scripts/checkLinksFormat.ts && find ./pages -name '*.md*' -print0 | xargs -0 -n1 pnpm markdown-link-check --progress --config linkchecker-config.json",
    "lint": "eslint . && vale pages/ --minAlertLevel=error",
    "start": "serve out",
    "test": "NODE_OPTIONS='--experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning' node --env-file-if-exists=.env --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "prepush": "pnpm lint && pnpm typecheck && pnpm validate-resources",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safe-global/safe-docs.git"
  },
  "author": "Safe Core Contributors <support@safe.global>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/safe-global/safe-docs/issues"
  },
  "homepage": "https://github.com/safe-global/safe-docs#readme",
  "dependencies": {
    "@code-hike/mdx": "^0.9.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@next/third-parties": "^14.2.35",
    "@svgr/webpack": "^8.1.0",
    "fuse.js": "^7.0.0",
    "lodash": "^4.18.1",
    "next": "^14.2.35",
    "nextra": "2.13.4",
    "nextra-theme-docs": "2.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "dotenv": "^17.2.0",
    "eslint": "8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "markdown-link-check": "^3.14.2",
    "open-graph-scraper": "^6.11.0",
    "prettier": "^3.8.3",
    "serve": "^14.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
