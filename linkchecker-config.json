{
  "ignorePatterns": [
    {
      "pattern": "^\\{"
    },
    {
      "pattern": "^https://x.com"
    },
    {
      "pattern": "^https://linkedin.com"
    },
    {
      "pattern": "^https://dune.com"
    },
    {
      "pattern": "^https://etherscan.io"
    },
    {
      "pattern": "^https://monerium.dev"
    },
    {
      "pattern": "^https://sandbox.monerium.dev"
    },
    {
      "pattern": "^https://trustwallet.com"
    },
    {
      "pattern": "^https://dashboard.pimlico.io"
    },
    {
      "pattern": "^https://fireblocks.com"
    },
    {
      "pattern": "^https://zengo.com"
    },
    {
      "pattern": "^https://api.stripe.com"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^#",
      "replacement": "./#"
    },
    {
      "pattern": "^/(?=[^#?]+\\.(png|jpe?g|svg|gif|ico|txt|xml|json|webp)$)",
      "replacement": "{{BASEURL}}/public/"
    },
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/pages/"
    }
  ],
  "retryOn429": true,
  "fallbackRetryDelay": "30s"
}
